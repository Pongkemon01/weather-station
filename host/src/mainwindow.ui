          </item>
          <item>
           <layout class="QVBoxLayout" name="aboutTextLayout">
            <property name="spacing"><number>8</number></property>
            <item>
             <widget class="QLabel" name="aboutTitleLabel">
              <property name="text"><string>Weather Station Control Center</string></property>
              <property name="font">
               <font>
                <pointsize>14</pointsize>
                <weight>75</weight>
                <bold>true</bold>
               </font>
              </property>
