      <widget class="QWidget" name="generalSettingsTab">
       <attribute name="title">
        <string>General Settings</string>
       </attribute>
       <layout class="QVBoxLayout" name="genVLayout">
        <property name="spacing"><number>6</number></property>
        <property name="leftMargin"><number>12</number></property>
        <property name="topMargin"><number>12</number></property>
        <property name="rightMargin"><number>12</number></property>
        <property name="bottomMargin"><number>12</number></property>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Region ID:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="genRegionIdSpin">
          <property name="enabled"><bool>false</bool></property>
          <property name="minimum"><number>0</number></property>
          <property name="maximum"><number>65535</number></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Station ID:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="genStationIdSpin">
          <property name="enabled"><bool>false</bool></property>
          <property name="minimum"><number>0</number></property>
          <property name="maximum"><number>65535</number></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Sampling Interval:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="genSamplingIntervalSpin">
          <property name="enabled"><bool>false</bool></property>
          <property name="suffix"><string> minutes</string></property>
          <property name="minimum"><number>1</number></property>
          <property name="maximum"><number>60</number></property>
          <property name="value"><number>10</number></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Server DNS:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="genServerDnsEdit">
          <property name="enabled"><bool>false</bool></property>
          <property name="placeholderText"><string>Max 63 characters</string></property>
          <property name="maxLength"><number>63</number></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Sensor Upload Path:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="genSensorPathEdit">
          <property name="enabled"><bool>false</bool></property>
          <property name="placeholderText"><string>Max 63 characters</string></property>
          <property name="maxLength"><number>63</number></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel">
          <property name="text"><string>Firmware Path:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="genFirmwarePathEdit">
          <property name="enabled"><bool>false</bool></property>
          <property name="placeholderText"><string>Max 63 characters</string></property>
          <property name="maxLength"><number>63</number></property>
         </widget>
        </item>
        <item>
         <spacer name="genVSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
         </spacer>
        </item>
        <item>
         <widget class="QFrame" name="genSep">
          <property name="frameShape"><enum>QFrame::HLine</enum></property>
          <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout">
          <item>
           <spacer>
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="genDiscardButton">
            <property name="text"><string>Discard</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
