// robin_wsc.rc — Windows version-info resource.
//
// Compiled by windres (MinGW) into the executable so that Windows Explorer's
// "Properties → Details" tab shows correct product/version metadata.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RobinLab"
            VALUE "FileDescription",  "Robin Weather Station Configurator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "robin_wsc"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RobinLab"
            VALUE "OriginalFilename", "robin_wsc.exe"
            VALUE "ProductName",      "Robin Weather Station"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
